# Local development. The same shared `yuktisetu` database the Java fleet uses --
# this service is the only writer of coding_profile_snapshots.
YS_DB_URL=postgresql://yuktisetu:YuktiSetu!2026@localhost:5432/yuktisetu
YS_LOG_LEVEL=DEBUG
YS_API_PORT=8090

# Reuse a successful snapshot younger than this many minutes instead of scraping
# again. Short, because a capture is meant to be the student's figures at the
# moment they applied.
YS_SNAPSHOT_FRESH_MINUTES=30

# Attempts happen at +0, then at these offsets (minutes) from when the job was
# queued. "15,60" = retry after 15 minutes, then after 45 more, then give up and
# flag the student for TnP review. Every job also has an absolute limit,
# give_up_at (70 minutes by default), which nothing can extend.
YS_RETRY_OFFSETS_MINUTES=15,60

# Circuit breaker: how long a platform is paused after its 1st, 2nd, 3rd, 4th+
# consecutive block, and how many consecutive platform errors count as a block.
YS_BREAKER_PAUSE_MINUTES=5,10,20,40
YS_BREAKER_ERROR_THRESHOLD=3

# Per-platform politeness, requests per second. Codeforces publishes one call
# per two seconds; the rest are guesses biased low, because being blocked cannot
# be undone quickly.
YS_RATE_CODEFORCES=0.5
YS_RATE_LEETCODE=1.0
YS_RATE_CODECHEF=0.5
YS_RATE_DEFAULT=0.5
